<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar <%= personaje.name %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1>Editar: <%= personaje.name %></h1>
    <form action="/starwars/<%= personaje.name %>?_method=PATCH" method="POST">
        <label>Altura (height)
            <input type="text" name="height" value="<%= personaje.height %>" required>
        </label>
        <label>Masa (mass)
            <input type="text" name="mass" value="<%= personaje.mass %>" required>
        </label>
        <div class="acciones">
            <button type="submit" class="btn">Actualizar</button>
            <a href="/starwars/<%= personaje.name %>">Cancelar</a>
        </div>
    </form>
</body>
</html>